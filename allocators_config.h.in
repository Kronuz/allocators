/*
 * Generated by CMake from allocators_config.h.in. This is the standalone
 * library's own feature-detection header: it replaces Xapiand's project-wide
 * "config.h", which allocators.cc used for two macros.
 *
 *   XAPIAND_TRACKED_MEM  Enables the global operator new/delete byte accounting
 *                        and the tracked_allocator counters. Driven by the CMake
 *                        option ALLOCATORS_TRACKED_MEM (default OFF). When off,
 *                        total_allocated()/local_allocated() are stubs that
 *                        return 0 and no global new/delete is overridden.
 *
 *   HAS_THREAD_LOCAL     Whether thread_local is usable; picks the thread-local
 *                        counter over the mutex-guarded global map. Detected with
 *                        check_cxx_source_compiles(); C++20 always has it.
 *
 * Do not edit by hand. Edit allocators_config.h.in and re-run CMake.
 */

#pragma once

#cmakedefine XAPIAND_TRACKED_MEM 1
#cmakedefine HAS_THREAD_LOCAL 1
